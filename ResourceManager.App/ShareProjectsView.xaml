<UserControl x:Class="ResourceManager.App.ShareProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Loaded="View_Loaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#708099"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,0,28,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="搜索项目" Style="{StaticResource Label}" Margin="0,0,0,7"/>
            <TextBlock Grid.Column="1" Text="项目类型" Style="{StaticResource Label}" Margin="0,0,0,7"/>
            <TextBox x:Name="ProjectSearch" Grid.Row="1" TextChanged="Search_Changed" Margin="0,0,10,0"
                     AutomationProperties.Name="搜索分享项目" ToolTip="搜索项目名称、简介、标签或分类"/>
            <ComboBox x:Name="ProjectFilter" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="筛选项目类型">
                <ComboBoxItem Content="全部项目"/><ComboBoxItem Content="可在线体验"/><ComboBoxItem Content="可下载"/>
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Content="刷新" Click="Refresh_Click" Margin="10,0,0,0"/>
            <Button Grid.Row="1" Grid.Column="3" Content="打开分享站" Click="OpenSite_Click" Margin="10,0,0,0"
                    Background="#EDF2F8" Foreground="#2867D9"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CatalogStatus" Text="进入此页后加载分享站项目" Style="{StaticResource Label}"/>
            <TextBlock x:Name="CatalogError" Visibility="Collapsed" Foreground="#B74650" FontSize="12"
                       TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="ProjectList" ItemsSource="{Binding VisibleProjects}" SelectionChanged="Project_Changed"
                         Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="分享项目列表">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="White" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="12" Padding="17">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8DB4FF"/><Setter TargetName="Card" Property="Background" Value="#F0F6FF"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8DB4FF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Project.Title}" FontSize="16" FontWeight="SemiBold" Foreground="#1B2B43" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Project.Summary}" Foreground="#53647B" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding TagsLabel}" Style="{StaticResource Label}" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding AvailabilityLabel}" Foreground="#2867D9" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ProjectEmpty" Visibility="Collapsed" Text="暂无已发布项目" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="15"/>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="14" Padding="22">
                <Grid>
                    <TextBlock x:Name="DetailPlaceholder" Text="选择项目查看详情" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ProjectDetail">
                            <TextBlock Text="{Binding Project.Title}" FontSize="22" FontWeight="SemiBold" Foreground="#1B2B43" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding TagsLabel}" Foreground="#2867D9" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Project.Summary}" Foreground="#34465E" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,16,0,0"/>
                            <WrapPanel Margin="0,16,0,4">
                                <Button Content="在线体验 ↗" Click="OpenWeb_Click" Visibility="{Binding WebVisibility}" Margin="0,0,8,8"/>
                                <Button Content="项目网页 ↗" Click="OpenProject_Click" Background="#EDF2F8" Foreground="#2867D9" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Description}" Foreground="#53647B" TextWrapping="Wrap" FontSize="13" LineHeight="22" Margin="0,8,0,0"/>
                            <StackPanel Visibility="{Binding DownloadsVisibility}" Margin="0,22,0,0">
                                <TextBlock Text="下载文件" Foreground="#1B2B43" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="在默认浏览器中下载" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                                <ItemsControl ItemsSource="{Binding Downloads}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="#F6F8FB" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Download.FileName}" Foreground="#34465E" FontSize="13" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Metadata}" Style="{StaticResource Label}" Margin="0,5,0,0"/>
                                                <Button Content="下载 ↗" Click="Download_Click" Tag="{Binding Download.DownloadUrl}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
