<Window x:Class="ResourceManager.App.SendReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送资源提醒" Width="500" Height="460" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F6F8FB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2867D9"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="发送资源提醒" FontSize="20" FontWeight="SemiBold" Foreground="#1B2B43"/>
        <StackPanel Grid.Row="1" Margin="0,6,0,16">
            <TextBlock x:Name="ResourceText" FontSize="13" FontWeight="SemiBold" Foreground="#1B2B43" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="选择一台在线设备；对方会直接看到置顶提醒弹窗，是否下载由对方决定。" FontSize="12" Foreground="#708099" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="PeerList" Grid.Row="2" SelectionChanged="PeerList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Nickname}" FontSize="14" FontWeight="SemiBold" Foreground="#1B2B43"/><TextBlock Text="{Binding Address}" FontSize="12" Foreground="#708099" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogButton}" Background="#EDF2F8" Foreground="#1B2B43" Margin="0,0,8,0"/>
            <Button x:Name="SendButton" Content="发送提醒" IsDefault="True" Click="Send_Click" Style="{StaticResource DialogButton}" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
