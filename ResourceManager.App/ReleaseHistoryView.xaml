<UserControl x:Class="ResourceManager.App.ReleaseHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="Transparent">
    <Grid Margin="28,0,28,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="按版本或功能检索" Foreground="#708099" FontSize="12" Margin="0,0,0,7"/>
                <TextBox x:Name="HistorySearch" MaxWidth="420" HorizontalAlignment="Left" Width="Auto"
                         MinWidth="220" Padding="12,9" TextChanged="Search_Changed"
                         AutomationProperties.Name="搜索版本或功能" ToolTip="例如：0.7、聊天、MCP、服务器"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,4">
                <TextBlock Text="{Binding CurrentVersionLabel}" Foreground="#2867D9" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="HistoryCount" Foreground="#708099" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding VisibleEntries}" BorderThickness="0"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="版本更新时间轴">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="2" Height="29" Background="#D5E1F1" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding TopLineVisibility}"/>
                        <Border Width="2" Background="#D5E1F1" HorizontalAlignment="Center" Margin="0,29,0,0" Visibility="{Binding BottomLineVisibility}"/>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0"
                                 Fill="{Binding DotColor}" Stroke="#F6F8FB" StrokeThickness="2"/>
                        <Border Grid.Column="2" Background="White" BorderBrush="{Binding CardBorder}" BorderThickness="1"
                                CornerRadius="14" Padding="22,18" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VersionLabel}" FontSize="20" FontWeight="SemiBold" Foreground="#1B2B43" VerticalAlignment="Center"/>
                                        <Border Background="#EAF2FF" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" Visibility="{Binding CurrentVisibility}" VerticalAlignment="Center">
                                            <TextBlock Text="当前版本" Foreground="#2867D9" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="12" Foreground="#708099" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Entry.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#53647B" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="{Binding Background}" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#34465E"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="HistoryEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="没有找到匹配的更新" FontSize="17" FontWeight="SemiBold" Foreground="#53647B" HorizontalAlignment="Center"/>
            <TextBlock Text="换一个版本号或功能关键词试试" Foreground="#708099" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
