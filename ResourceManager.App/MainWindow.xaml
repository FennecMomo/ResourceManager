<Window x:Class="ResourceManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资源管理器" Width="1260" Height="820" MinWidth="1010" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="#F6F8FB" FontFamily="Segoe UI"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B2B43"/>
        <SolidColorBrush x:Key="Muted" Color="#708099"/>
        <SolidColorBrush x:Key="Accent" Color="#2867D9"/>
        <SolidColorBrush x:Key="Line" Color="#E4EAF2"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8DB4FF"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFF0F0"/><Setter Property="Foreground" Value="#B74650"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="11,0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE4EE"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF4FF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#91B8FC"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#53647B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#F1F5FB"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#EAF2FF"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ResourceGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE8B7;"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="文件"><Setter Property="Text" Value="&#xE8A5;"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Meta}">
            <Setter Property="Foreground" Value="#238264"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="离线"><Setter Property="Foreground" Value="#B67442"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="离线/无法连接"><Setter Property="Foreground" Value="#B67442"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="未检查"><Setter Property="Foreground" Value="#708099"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="设备已变更"><Setter Property="Foreground" Value="#B74650"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="资源已撤销"><Setter Property="Foreground" Value="#B74650"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="原文件不可用"><Setter Property="Foreground" Value="#B74650"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="设备已移除"><Setter Property="Foreground" Value="#B74650"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="等待下载"><Setter Property="Foreground" Value="#708099"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="下载中"><Setter Property="Foreground" Value="#2867D9"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已暂停"><Setter Property="Foreground" Value="#B67442"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已中断"><Setter Property="Foreground" Value="#B74650"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="14,8">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#F1F5FB"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EAF2FF"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,17,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,40">
                    <Image Source="Assets/ResourceManager.png" Width="38" Height="38" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="资源管理器" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="局域网资源共享" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="工作空间" Style="{StaticResource Caption}" Margin="16,0,0,12" FontWeight="SemiBold"/>
                <ListBox x:Name="NavList" Grid.Row="2" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged" SelectedIndex="0">
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="设备"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="我的发布"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="收藏"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="下载"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="设置"/></StackPanel></ListBoxItem>
                </ListBox>
                <Border Grid.Row="3" Background="#F4F8FE" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="只分享你选择的资源" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="关闭窗口后可继续在托盘共享；退出时会停止。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="设备" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="PageSubtitleText" Text="连接同事的电脑，浏览他们分享的资源" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="IdentityText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextAlignment="Right"/>
                        <TextBlock x:Name="AddressText" Style="{StaticResource Caption}" TextAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="Tabs" Grid.Row="1" SelectedIndex="0" SelectionChanged="Tabs_SelectionChanged">
                <TabItem Header="设备">
                    <Grid Margin="28,23,28,22">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <TabControl Style="{StaticResource ConnectionTabControl}" MinHeight="148">
                                <TabItem Header="直接连接" Style="{StaticResource ConnectionTabItem}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="输入设备地址，或查找同一局域网内正在运行的设备。" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <Button x:Name="DiscoverPeersButton" Grid.Column="1" Content="查找局域网" Click="DiscoverPeers_Click" Style="{StaticResource SecondaryButton}"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="IP 地址" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="PeerIpBox" ToolTip="例如 192.168.1.20"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="端口" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="PeerPortBox" Text="37642"/></StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="连接" Click="Connect_Click" Margin="0,0,6,0"/><Button x:Name="UpdateAddressButton" Content="更新地址" Click="UpdateAddress_Click" Style="{StaticResource SecondaryButton}" ToolTip="选择设备后更新地址" IsEnabled="False"/></StackPanel>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="路由器入口" Style="{StaticResource ConnectionTabItem}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="入口名称" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="GatewayNameBox" ToolTip="名称，例如办公室华为路由器"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="路由器 WAN IPv4（扫描 48001–48099）" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="GatewayIpBox" ToolTip="路由器外部入口，例如 192.168.2.20"/></StackPanel>
                                            <TextBlock Grid.Column="2" Text="受信网络" Foreground="#9B6A12" Background="#FFF4D9" Padding="8,4" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ListBox x:Name="GatewayList" ItemsSource="{Binding Gateways}" SelectionChanged="GatewayList_SelectionChanged" Height="52" Padding="0" BorderThickness="0" Background="Transparent">
                                                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><TextBlock Style="{StaticResource Meta}" Margin="0,3,0,0"><Run Text="{Binding WanIp}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button x:Name="GatewayAddButton" Content="添加并扫描" Click="AddGateway_Click" Padding="12,0" Margin="0,0,6,0"/>
                                                <Button x:Name="GatewaySaveButton" Content="保存" Click="SaveGatewayAddress_Click" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="0,0,6,0"/>
                                                <Button x:Name="GatewayRefreshButton" Content="刷新" Click="RefreshGateway_Click" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="0,0,6,0"/>
                                                <Button x:Name="GatewayRemoveButton" Content="移除" Click="RemoveGateway_Click" Style="{StaticResource QuietButton}" Padding="10,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="GatewayProgressText" Grid.ColumnSpan="2" Text="未添加路由器入口" Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="已连接的设备" Style="{StaticResource CardHeading}"/><TextBlock Text="选择设备查看资源" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                                        <Button Grid.Column="1" Content="刷新" Click="Refresh_Click" Style="{StaticResource QuietButton}"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="PeersGrid" ItemsSource="{Binding Peers}" SelectionChanged="PeersGrid_SelectionChanged">
                                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="17" Background="#EAF2FF" VerticalAlignment="Center">
                                                    <Grid><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="34" Height="34"><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Nickname}" Style="{StaticResource ItemTitle}"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0" ToolTip="{Binding Address}"><TextBlock Text="{Binding Source}" Style="{StaticResource Meta}"/><TextBlock Text="  ·  " Style="{StaticResource Meta}"/><TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/></StackPanel><TextBlock Text="{Binding NoteText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding NoteText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Meta}"><Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                            </Grid></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="还没有连接的设备。&#10;在上方输入同事的 IP 地址开始连接。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Peers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                        <TextBlock Text="本机备注（仅自己可见，不改变对方昵称）" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="PeerNoteBox" MaxLength="100" Margin="0,6,0,8" ToolTip="例如：设计部张工"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SavePeerNoteButton" Content="保存备注" Click="SavePeerNote_Click" Margin="0,0,8,0" IsEnabled="False"/>
                                            <Button x:Name="ClearPeerNoteButton" Content="清空" Click="ClearPeerNote_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                                        </StackPanel>
                                        <Button x:Name="RemovePeerButton" Content="移除所选设备" Click="RemovePeer_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,15"><TextBlock x:Name="PeerHeading" Text="选择一台设备" Style="{StaticResource CardHeading}"/><TextBlock Text="可下载的资源会直接从对方电脑传输" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="RemoteGrid" ItemsSource="{Binding RemoteResources}" SelectionChanged="RemoteGrid_SelectionChanged">
                                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ResourceGlyph}"/>
                                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0"><Run Text="{Binding Kind}"/><Run Text="  ·  "/><Run Text="{Binding Size}"/><Run Text="  ·  "/><Run Text="{Binding Mode}"/></TextBlock></StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="PeerEmptyText" Text="从左侧选择一台设备，查看对方的资源。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RemoteResources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="RemoteDownloadButton" Content="下载资源" Click="DownloadRemote_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                        <Button x:Name="RemoteFavoriteButton" Content="加入收藏" Click="Favorite_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="我的发布">
                    <Grid Margin="28,23,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="分享给已连接的设备" Style="{StaticResource PageHeading}"/><TextBlock Text="只有你主动发布的文件和文件夹会被看到。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="发布文件" Click="PublishFile_Click" Margin="0,0,8,0"/><Button Content="发布文件夹" Click="PublishFolder_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
                        </Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="正在发布" Style="{StaticResource CardHeading}"/><TextBlock Text="引用会跟随原文件变化；副本保留发布时的内容。" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="刷新" Click="RefreshLocal_Click" Style="{StaticResource QuietButton}"/></Grid>
                            <Grid Grid.Row="1"><ListBox x:Name="LocalGrid" ItemsSource="{Binding LocalResources}" SelectionChanged="LocalGrid_SelectionChanged">
                                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ResourceGlyph}"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><TextBlock Style="{StaticResource Meta}" Margin="0,5,0,0"><Run Text="{Binding Kind}"/><Run Text="  ·  "/><Run Text="{Binding Size}"/><Run Text="  ·  "/><Run Text="{Binding Mode}"/></TextBlock><TextBlock Text="{Binding Path}" Style="{StaticResource Meta}" Margin="0,4,10,0" ToolTip="{Binding Path}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox><TextBlock Text="这里还没有发布的资源。&#10;点击上方按钮，选择文件或文件夹开始共享。" TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LocalResources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                            <Button x:Name="RemoveResourceButton" Grid.Row="2" Content="撤销所选发布" Click="RemoveResource_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/>
                        </Grid></Border>
                    </Grid>
                </TabItem>

                <TabItem Header="收藏">
                    <Grid Margin="28,23,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="常用资源，随时找得到" Style="{StaticResource PageHeading}"/><TextBlock Text="收藏保存资源入口。对方离线时入口仍在，重新上线后即可恢复使用。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="我的收藏" Style="{StaticResource CardHeading}"/><TextBlock Text="在线、离线和已撤销状态会自动更新" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="检查状态" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"/></Grid>
                            <Grid Grid.Row="1"><ListBox x:Name="FavoritesGrid" ItemsSource="{Binding Favorites}" SelectionChanged="FavoritesGrid_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#E8A640" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><TextBlock Style="{StaticResource Meta}" Margin="0,5,0,0"><Run Text="来自 "/><Run Text="{Binding PeerName}"/><Run Text="  ·  "/><Run Text="{Binding Kind}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <TextBlock Text="还没有收藏资源。&#10;浏览设备里的资源，点击“加入收藏”。" TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favorites.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="FavoriteDownloadButton" Content="下载资源" Click="DownloadFavorite_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RemoveFavoriteButton" Content="取消收藏" Click="RemoveFavorite_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                </TabItem>

                <TabItem Header="下载">
                    <Grid Margin="28,23,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="下载到本地，离线也能用" Style="{StaticResource PageHeading}"/><TextBlock Text="传输中断后可继续任务；已完成的文件保存在你选择的位置。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="下载任务" Style="{StaticResource CardHeading}" Margin="0,0,0,16"/>
                            <Grid Grid.Row="1"><ListBox x:Name="DownloadsGrid" ItemsSource="{Binding Downloads}" SelectionChanged="DownloadsGrid_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0"><Run Text="来自 "/><Run Text="{Binding PeerName}"/><Run Text="  ·  "/><Run Text="{Binding Progress}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><StackPanel Grid.Row="1" Margin="38,10,0,0"><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="5" Foreground="{StaticResource Accent}" Background="#E8EDF5" BorderThickness="0"/><TextBlock Text="{Binding Target}" Style="{StaticResource Meta}" Margin="0,7,0,0" ToolTip="{Binding Target}"/><TextBlock Text="{Binding Error}" Foreground="#B74650" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <TextBlock Text="还没有下载任务。&#10;从设备或收藏中选择资源，点击“下载资源”。" TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Downloads.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ResumeDownloadButton" Content="继续任务" Click="ResumeDownload_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="OpenDownloadFolderButton" Content="打开保存位置" Click="OpenDownloadFolder_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RemoveDownloadButton" Content="移除任务" Click="RemoveDownload_Click" Style="{StaticResource DangerButton}" IsEnabled="False"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                </TabItem>

                <TabItem Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,23,28,22" Width="700" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                            <TextBlock Text="你的资料" Style="{StaticResource PageHeading}"/><TextBlock Text="其他设备连接你时，会看到这里的昵称和头像。" Style="{StaticResource Caption}" Margin="0,5,0,22"/>
                            <TextBlock Text="昵称" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="NicknameBox" Margin="0,0,0,20"/>
                            <TextBlock Text="头像" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal"><Border Width="56" Height="56" Background="#EAF2FF" CornerRadius="28" Margin="0,0,14,0"><Image x:Name="AvatarPreview" Stretch="UniformToFill"/></Border><Button Content="选择头像" Click="ChooseAvatar_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="清除" Click="ClearAvatar_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Center"/></StackPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                            <TextBlock Text="连接与运行" Style="{StaticResource PageHeading}"/><TextBlock Text="对方通过你的 IP 地址和监听端口连接。" Style="{StaticResource Caption}" Margin="0,5,0,22"/>
                            <TextBlock Text="监听端口" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="ListenPortBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                            <CheckBox x:Name="CloseToTrayBox" Content="关闭窗口后继续在系统托盘共享" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoStartBox" Content="登录 Windows 后自动启动并在托盘共享" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
                            <TextBlock Text="开机启动仅为当前 Windows 用户设置，不需要管理员权限。" Style="{StaticResource Caption}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                            <TextBlock Text="当前路由器" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="外部设备需要填写“路由器外部入口”。请把这个地址提供给路由器外的设备。" Style="{StaticResource Caption}" Margin="0,5,0,18" TextWrapping="Wrap"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="网络适配器" Style="{StaticResource Caption}" Margin="0,0,0,9"/><TextBlock x:Name="RouterAdapterText" Grid.Column="1" Text="正在读取…" Foreground="{StaticResource Ink}" Margin="0,0,0,9"/>
                                <TextBlock Grid.Row="1" Text="路由器本地地址" Style="{StaticResource Caption}" Margin="0,0,0,9"/><TextBlock x:Name="RouterLanText" Grid.Row="1" Grid.Column="1" Text="正在读取…" Foreground="{StaticResource Ink}" Margin="0,0,0,9"/>
                                <TextBlock Grid.Row="2" Text="路由器外部入口" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock x:Name="RouterWanText" Grid.Row="2" Grid.Column="1" Text="正在读取…" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Grid.Row="3" Text="UPnP" Style="{StaticResource Caption}" Margin="0,0,0,9"/><TextBlock x:Name="RouterUpnpText" Grid.Row="3" Grid.Column="1" Text="正在读取…" Foreground="{StaticResource Ink}" Margin="0,0,0,9"/>
                                <TextBlock Grid.Row="4" Text="本机外部端口" Style="{StaticResource Caption}"/><TextBlock x:Name="RouterMappingText" Grid.Row="4" Grid.Column="1" Text="正在读取…" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="CopyRouterWanButton" Content="复制外部入口 IP" Click="CopyRouterWan_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RemoveRouterMappingButton" Content="删除本机外部映射" Click="RemoveRouterMapping_Click" Style="{StaticResource DangerButton}" IsEnabled="False"/></StackPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                            <TextBlock Text="软件更新" Style="{StaticResource PageHeading}"/><TextBlock Text="从 GitHub 或已连接设备发布的 ResourceManager 程序下载更新；安装前会核对版本、大小和 SHA-256。" Style="{StaticResource Caption}" Margin="0,5,0,22" TextWrapping="Wrap"/>
                            <CheckBox x:Name="AutoUpdateBox" Content="启动后自动检查更新" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/><TextBlock x:Name="UpdateStatusText" Text="当前版本" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                        </StackPanel></Border>
                        <Button Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                        <TextBlock Text="设备 ID" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock x:Name="DeviceIdText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="首次运行如 Windows 防火墙提示，请允许公司网络访问。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="正在启动…" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="28,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
