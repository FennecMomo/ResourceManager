<Window x:Class="ResourceManager.App.AiRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 文件查找请求" Width="960" Height="720" MinWidth="820" MinHeight="600"
        Background="#F6F8FB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="AI 文件查找请求" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="授权后，使用本机 Codex 登录与额度，在选定目录内只读查找。相关文件可由请求方通过 ResourceManager 私发副本取回。目录清单与必要文本片段会交给 Codex 处理；可随时取消或撤销目录授权。"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Codex CLI" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="CliPath" Grid.Column="1" IsReadOnly="True" ToolTip="请选择已安装并登录的 codex.exe"/>
            <Button Grid.Column="2" Content="选择程序" Click="ChooseCli_Click" Margin="8,0,0,0"/>
        </Grid>
        <TabControl Grid.Row="2">
            <TabItem Header="收到的请求">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="Requests" DisplayMemberPath="Label" SelectionChanged="Request_SelectionChanged"/>
                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Grid.Row="1" Text="本次允许查找的目录（仅显示此设备的授权）" Margin="0,12,0,6"/>
                        <ComboBox Grid.Row="2" x:Name="ApprovalScopes" DisplayMemberPath="Directory" MinHeight="32"/>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button x:Name="ApproveButton" Content="允许本次请求" Click="Approve_Click"/>
                            <Button Content="拒绝 / 取消" Click="Cancel_Click"/>
                            <Button Content="刷新" Click="Refresh_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="目录授权">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="Scopes" DisplayMemberPath="Label"/>
                    <ComboBox x:Name="Devices" Grid.Row="1" DisplayMemberPath="Nickname" MinHeight="32" Margin="0,14,0,8"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPath" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox Grid.Row="3" x:Name="AutoApprove" Content="此设备在此目录内免逐次授权（可查找并取回结果文件）" Margin="0,12,0,12"/>
                    <WrapPanel Grid.Row="4"><Button Content="保存目录授权" Click="SaveScope_Click"/><Button Content="撤销选中授权" Click="RemoveScope_Click"/></WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#48617C"
                   Text="默认逐次授权；先在“目录授权”选择设备和目录，再允许请求。每次授权 30 分钟、最多 10 轮。"/>
    </Grid>
</Window>
