<Window x:Class="ResourceManager.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用帮助 · 资源管理器" Width="1020" Height="760" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F8FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="HelpInk" Color="#1B2B43"/>
        <SolidColorBrush x:Key="HelpMuted" Color="#708099"/>
        <SolidColorBrush x:Key="HelpLine" Color="#E4EAF2"/>
        <Style x:Key="ChapterItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="#53647B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChapterBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChapterBorder" Property="Background" Value="#F1F5FB"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChapterBorder" Property="Background" Value="#EAF2FF"/>
                                <Setter Property="Foreground" Value="#2867D9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChapterBorder" Property="BorderBrush" Value="#2867D9"/>
                                <Setter TargetName="ChapterBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource HelpLine}" BorderThickness="0,0,0,1">
            <StackPanel Margin="28,0" VerticalAlignment="Center">
                <TextBlock Text="使用帮助" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource HelpInk}"/>
                <TextBlock Text="按章节了解资源管理器的各个模块" FontSize="12" Foreground="{StaticResource HelpMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource HelpLine}" BorderThickness="1" CornerRadius="14" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="章节目录" Foreground="{StaticResource HelpMuted}" FontSize="12"
                               FontWeight="SemiBold" Margin="10,8,0,12"/>
                    <ListBox x:Name="ChapterList" ItemsSource="{Binding Chapters}" SelectionChanged="Chapter_SelectionChanged"
                             ItemContainerStyle="{StaticResource ChapterItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="帮助章节">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" Width="27" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource HelpLine}" BorderThickness="1" CornerRadius="14">
                <ScrollViewer x:Name="ChapterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="30,26,30,26" DataContext="{Binding SelectedItem, ElementName=ChapterList}">
                    <StackPanel>
                        <TextBlock Text="{Binding Number, StringFormat=第 {0} 章}" FontSize="12" FontWeight="SemiBold" Foreground="#2867D9"/>
                        <TextBlock x:Name="ChapterTitle" Text="{Binding Title}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{StaticResource HelpInk}" Margin="0,7,0,5"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{StaticResource HelpMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Intro}" FontSize="13" LineHeight="22" Foreground="{StaticResource HelpInk}"
                                   TextWrapping="Wrap" Margin="0,20,0,20"/>

                        <Border Background="#F4F8FE" BorderBrush="#DAE7F8" BorderThickness="1" CornerRadius="12" Padding="16,15"
                                AutomationProperties.Name="本章节操作流程示意图">
                            <StackPanel>
                                <TextBlock Text="操作示意图" FontSize="12" FontWeight="SemiBold" Foreground="#54749F" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Illustration}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#DAE7F8" BorderThickness="1" CornerRadius="10"
                                                    Padding="12" MinHeight="140" Margin="0,0,9,0" AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <Grid Height="31"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#2867D9"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="#9BB4D7"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HelpInk}"
                                                               TextWrapping="Wrap" Margin="0,9,0,5"/>
                                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource HelpMuted}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="图中内容仅用于说明操作，不代表真实设备或文件。" FontSize="11"
                                           Foreground="#7890AE" Margin="0,11,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="操作步骤" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource HelpInk}" Margin="0,25,0,14"/>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#EAF2FF" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="#2867D9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HelpInk}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource HelpMuted}"
                                                       TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#FFF8E9" BorderBrush="#F0DEB5" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Tip, StringFormat=提示：{0}}" Foreground="#806226" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource HelpLine}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="选择左侧章节可随时切换内容" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource HelpMuted}"/>
                <Button Grid.Column="1" Content="关闭" Click="Close_Click" Width="74" Height="32" VerticalAlignment="Center"
                        Background="#EDF2F8" Foreground="{StaticResource HelpInk}" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
